# Project Settings
PROJECT_NAME="FastAPI Token Management Platform"

# Database PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=token_db

# Unit Testing DB
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/token_db_test

# Connection Pool
POOL_SIZE=20
MAX_OVERFLOW=10
POOL_TIMEOUT=30

# Security (JWT)
SECRET_KEY=super_secret_jwt_key_development_only_change_in_prod
ALGORITHM=HS256
# Initial User Setup
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin_password_123
